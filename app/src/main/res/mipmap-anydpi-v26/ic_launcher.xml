<?xml version="1.0" encoding="utf-8"?>
<!-- Her artwork: the CB750 with the route and the pin (NVII-DASH
     assets/icons/navi-maskable-512.png - the same art as navi-1024.png and the
     Flet app's icon) as the whole foreground, on its own dark ground. The
     maskable version keeps the ring inside what any launcher's mask shows.
     It was the map's yellow bike drawable before: not her logo. minSdk is 26,
     so an adaptive icon covers every phone this installs on. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/xnav_ground" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
