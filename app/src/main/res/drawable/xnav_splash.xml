<?xml version="1.0" encoding="utf-8"?>
<!-- Before Android 12 there is no system splash: the window itself is the
     first thing she sees. Her artwork (navi-512.png cut to its ring,
     tools/her-art.py) on its own ground, and nothing else. -->
